<?xml version="1.0" encoding="utf-8"?>
<!-- Teste técnico da Etapa 3: não é uma cena da novela. Sem voz gravada nesta etapa.
     F6 monta os mesmos modelos confirmados; F7 inicia/repite; F10 cancela/limpa.
     Total: 36 segundos. Cada fala dura 6 segundos. Narração nunca mexe a boca. -->
<Cena versao="1" id="teste_falas" nome="Etapa 3: boca, gestos e olhar">
  <Ambiente hora="17" minuto="0" clima="CLEAR" densidadeTransito="0"
            densidadePedestres="0" bloquearPolicia="true" />
  <Local referencia="jogador" distanciaFrente="4" />
  <Personagens>
    <Personagem id="homem" nome="Homem" modelo="a_m_y_business_01"
                direita="-0.8" frente="0" altura="0" olharPara="mulher" />
    <Personagem id="mulher" nome="Mulher" modelo="a_f_y_business_01"
                direita="0.8" frente="0" altura="0" olharPara="homem" />
  </Personagens>
  <Roteiro>
    <Narracao duracaoSegundos="3">Trecho de narração: os dois ficam sem falar.</Narracao>
    <Fala personagem="homem" duracaoSegundos="6" gesto="neutro">Olá. Estamos testando o movimento da boca e os gestos.</Fala>
    <Fala personagem="mulher" duracaoSegundos="6" gesto="explicando">Agora é minha vez. Observe minha boca e minhas mãos.</Fala>
    <Fala personagem="homem" duracaoSegundos="6" gesto="negando">Não. Isto é só um teste técnico, antes de gravar a história.</Fala>
    <Fala personagem="mulher" duracaoSegundos="6" gesto="implorando">Por favor, repare se minha boca continua mexendo até o fim.</Fala>
    <Fala personagem="homem" duracaoSegundos="6" gesto="irritado">Preste atenção! Quem está escutando deve olhar para quem fala.</Fala>
    <Narracao duracaoSegundos="3">Fim do teste: as duas bocas devem voltar ao normal.</Narracao>
  </Roteiro>
</Cena>

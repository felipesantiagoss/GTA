  "roteiro": [
    {
      "tipo": "fala",
      "duracaoSegundos": 8,
      "plano": "MEDIA",
      "texto": "Chega aqui, minha filha. Senta. Eu preciso te contar uma coisa antes que eu não consiga mais falar.",
      "personagem": "DONA_IRACI",
      "gesto": "implorando"
    },
    {
      "tipo": "fala",
      "duracaoSegundos": 6,
      "plano": "MEDIA",
      "texto": "Teu pai não morreu pobre. Teu pai morreu muito, muito rico.",
      "personagem": "DONA_IRACI",
      "gesto": "neutro"
    },
    {
      "tipo": "fala",
      "duracaoSegundos": 4,
      "plano": "MEDIA",
      "texto": "A senhora tá delirando, vó. É o remédio.",
      "personagem": "DJANIRA_POBRE",
      "gesto": "negando"
    },
    {
      "tipo": "fala",
      "duracaoSegundos": 12,
      "plano": "MEDIA",
      "texto": "Tem uma conta num banco americano. Tá no teu nome desde o dia que tu nasceu. Eu te trouxe pra roça pra ninguém te achar. Enquanto tu fosse pobre, tu tava viva.",
      "personagem": "DONA_IRACI",
      "gesto": "explicando"
    },
    {
      "tipo": "fala",
      "duracaoSegundos": 4,
      "plano": "MEDIA",
      "texto": "Por que é que a senhora nunca me contou isso?",
      "personagem": "DJANIRA_POBRE",
      "gesto": "neutro"
    },
    {
      "tipo": "fala",
      "duracaoSegundos": 8,
      "plano": "MEDIA",
      "texto": "Porque dinheiro sem idade pra segurar só serve pra te matar mais cedo, minha filha.",
      "personagem": "DONA_IRACI",
      "gesto": "neutro"
    }

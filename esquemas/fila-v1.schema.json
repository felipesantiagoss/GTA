    {
      "if": {
        "properties": {
          "episodio": {
            "const": 0
          }
        }
      },
      "then": {
        "properties": {
          "cenas": {
            "items": {
              "type": "string",
              "pattern": "^teste_(json|coreografia|fila_(0[1-9]|[1-9][0-9])|elenco_(pobre|rica))\\.json$"
            }
          }
        }
      }
    },
    {

  "properties": {
    "versao": {
      "type": "integer",
      "const": 1
    },
    "episodio": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15
    },
    "nome": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "\\S"
    },
    "cenas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "versao",
    "episodio",
    "nome",
    "cenas"
  ],
  "additionalProperties": false,

  "vozesMontagemFinal": [
    {
      "chaveVoz": "EP01_C01_B01",
      "cena": "EP01_C01",
      "tipo": "narracao",
      "tipoRuntime": "narracao",
      "quemOriginal": "DJANIRA",
      "textoOriginal": "Meu nome é Djanira. O que fizeram comigo foi tão deplorável que, se eu tô contando essa história, é porque eu sobrevivi. E sobreviver não foi sorte, foi teimosia.",
      "duracaoMs": 14000,
      "audioReal": null,
      "usarUmaVez": true
    },
    {
      "chaveVoz": "EP01_C02_B01",
      "cena": "EP01_C02",
      "tipo": "narracao",
      "tipoRuntime": "narracao",
      "quemOriginal": "DJANIRA",
      "textoOriginal": "A minha vida era bem diferente. Eu acordava antes do sol, trabalhava na roça e voltava pra casa com o corpo pedindo descanso.",
      "duracaoMs": 10000,
      "audioReal": null,
      "usarUmaVez": true
    },
    {
      "chaveVoz": "EP01_C03_B01",
      "cena": "EP01_C03",
      "tipo": "narracao",
      "tipoRuntime": "narracao",
      "quemOriginal": "DJANIRA",
      "textoOriginal": "Eu morava com a minha avó, dona Iraci. Foi ela que me criou. Agora que ela tava muito doente, era a minha vez de cuidar dela.",
      "duracaoMs": 9000,
      "audioReal": null,
      "usarUmaVez": true
    },
    {
      "chaveVoz": "EP01_C04_B01",
      "cena": "EP01_C04",
      "tipo": "narracao",
      "tipoRuntime": "narracao",
      "quemOriginal": "DJANIRA",
      "textoOriginal": "Eu levava minha avó pro hospital, deixava ela na entrada e voltava pra trabalhar.",
      "duracaoMs": 7000,
      "audioReal": null,
      "usarUmaVez": true
    },
    {
      "chaveVoz": "EP01_C05_B01",
      "cena": "EP01_C05",
      "tipo": "narracao",
      "tipoRuntime": "narracao",
      "quemOriginal": "DJANIRA",
      "textoOriginal": "Tinha dia que ela passava horas fora. Mas isso é bem normal nos hospitais do SUS.",
      "duracaoMs": 8000,
      "audioReal": null,
      "usarUmaVez": true
    },
    {
      "chaveVoz": "EP01_C06_B01",
      "cena": "EP01_C06",
      "tipo": "narracao",
      "tipoRuntime": "narracao",
      "quemOriginal": "DJANIRA",
      "textoOriginal": "E tinha a Dinjer. Amiga de infância que virou aeromoça e vivia pra cima e pra baixo conhecendo o mundo.",
      "duracaoMs": 9000,
      "audioReal": null,
      "usarUmaVez": true
    },
    {
      "chaveVoz": "EP01_C07_B01",
      "cena": "EP01_C07",
      "tipo": "fala",
      "tipoRuntime": "fala",
      "quemOriginal": "COLEGA_1",
      "textoOriginal": "Eu pegaria ela só no off mesmo.",
      "duracaoMs": 3000,
      "audioReal": null,
      "usarUmaVez": true
    },
    {
      "chaveVoz": "EP01_C07_B02",
      "cena": "EP01_C07",
      "tipo": "fala",
      "tipoRuntime": "fala",
      "quemOriginal": "DINJER",
      "textoOriginal": "Eu acho que vocês deveriam me respeitar aqui, pois sou mulher, mãe, defensora do aborto, a aeromoça feminista assumidamente não monogâmica.",
      "duracaoMs": 9000,
      "audioReal": null,
      "usarUmaVez": true
    },
    {
      "chaveVoz": "EP01_C07_B03",
      "cena": "EP01_C07",
      "tipo": "fala",
      "tipoRuntime": "fala",
      "quemOriginal": "COLEGA_2",
      "textoOriginal": "Só faltou falar comunista.",
      "duracaoMs": 3000,
      "audioReal": null,
      "usarUmaVez": true
    },
    {
      "chaveVoz": "EP01_C07_B04",
      "cena": "EP01_C07",
      "tipo": "fala",
      "tipoRuntime": "fala",
      "quemOriginal": "DINJER",
      "textoOriginal": "Me respeita, cara. Tá tirando onda?",
      "duracaoMs": 3000,
      "audioReal": null,
      "usarUmaVez": true
    },
    {
      "chaveVoz": "EP01_C08_B01",
      "cena": "EP01_C08",
      "tipo": "narracao",
      "tipoRuntime": "narracao",
      "quemOriginal": "DJANIRA",
      "textoOriginal": "Ela não devia nem lembrar mais de mim, porque ela sumiu. Mas naquele dia ela apareceu com um problema.",
      "duracaoMs": 6000,
      "audioReal": null,
      "usarUmaVez": true
    },
    {
      "chaveVoz": "EP01_C08_B02",
      "cena": "EP01_C08",
      "tipo": "fala",
      "tipoRuntime": "fala",
      "quemOriginal": "DINJER",
      "textoOriginal": "Amiga, eu tô desesperada. Minha mãe tá doente, eu preciso pagar uns exames, comprar remédio, e o meu dinheiro não caiu. Pode me emprestar mil reais?",
      "duracaoMs": 9000,
      "audioReal": null,
      "usarUmaVez": true
    },
    {
      "chaveVoz": "EP01_C08_B03",
      "cena": "EP01_C08",
      "tipo": "fala",
      "tipoRuntime": "fala",
      "quemOriginal": "DJANIRA",
      "textoOriginal": "Amiga, eu tenho só o dinheiro do aluguel. Me promete que devolve em duas semanas?",
      "duracaoMs": 6000,
      "audioReal": null,
      "usarUmaVez": true
    },
    {
      "chaveVoz": "EP01_C08_B04",
      "cena": "EP01_C08",
      "tipo": "fala",
      "tipoRuntime": "fala",
      "quemOriginal": "DINJER",
      "textoOriginal": "Prometo pela vida da minha mãe.",
      "duracaoMs": 3000,
      "audioReal": null,
      "usarUmaVez": true
    },
    {
      "chaveVoz": "EP01_C08_B05",
      "cena": "EP01_C08",
      "tipo": "fala",
      "tipoRuntime": "fala",
      "quemOriginal": "DJANIRA",
      "textoOriginal": "Então tá bom. Vou fazer o Pix.",
      "duracaoMs": 3000,
      "audioReal": null,
      "usarUmaVez": true
    },
    {
      "chaveVoz": "EP01_C08_B06",
      "cena": "EP01_C08",
      "tipo": "fala",
      "tipoRuntime": "fala",
      "quemOriginal": "DINJER",
      "textoOriginal": "Amiga, muito obrigada. Te amo!",
      "duracaoMs": 3000,
      "audioReal": null,
      "usarUmaVez": true
    },
    {
      "chaveVoz": "EP01_C09_B01",
      "cena": "EP01_C09",
      "tipo": "narrador",
      "tipoRuntime": "narracao",
      "quemOriginal": "NARRADOR (voz masculina)",
      "textoOriginal": "E aí, será que a Dinjer vai pagar? Não perca o próximo episódio de A Caloteira do Oeste.",
      "duracaoMs": 7000,
      "audioReal": null,
      "usarUmaVez": true
    }
  ],

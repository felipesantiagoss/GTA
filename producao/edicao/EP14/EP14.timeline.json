  "legendas": [
    {
      "cena": "EP14_C01",
      "bloco": 1,
      "inicioMs": 0,
      "fimMs": 7000,
      "legenda": "Narrador: Ela apareceu no meu portão às onze da noite. Sem maquiagem, com o uniforme ainda."
    },
    {
      "cena": "EP14_C02",
      "bloco": 1,
      "inicioMs": 7000,
      "fimMs": 11000,
      "legenda": "Dinjer: Djanira. Djanira, é você mesmo?"
    },
    {
      "cena": "EP14_C02",
      "bloco": 2,
      "inicioMs": 11000,
      "fimMs": 16000,
      "legenda": "Djanira: Você levou três anos pra olhar na minha cara direito."
    },
    {
      "cena": "EP14_C02",
      "bloco": 3,
      "inicioMs": 16000,
      "fimMs": 21000,
      "legenda": "Dinjer: Amiga, eu procurei você. Eu juro que eu procurei."
    },
    {
      "cena": "EP14_C02",
      "bloco": 4,
      "inicioMs": 21000,
      "fimMs": 24000,
      "legenda": "Djanira: Não me chama de amiga."
    },
    {
      "cena": "EP14_C03",
      "bloco": 1,
      "inicioMs": 27000,
      "fimMs": 37000,
      "legenda": "Djanira: Eu vou te fazer uma pergunta só. E se você mentir, eu descubro hoje ainda, porque agora eu tenho dinheiro pra descobrir qualquer coisa."
    },
    {
      "cena": "EP14_C03",
      "bloco": 2,
      "inicioMs": 37000,
      "fimMs": 39000,
      "legenda": "Djanira: Você sabia?"
    },
    {
      "cena": "EP14_C03",
      "bloco": 4,
      "inicioMs": 43000,
      "fimMs": 45000,
      "legenda": "Djanira: Você sabia."
    },
    {
      "cena": "EP14_C04",
      "bloco": 1,
      "inicioMs": 51000,
      "fimMs": 58000,
      "legenda": "Dinjer: Eu não sabia que eles iam te matar. Eu juro pela minha mãe que eu não sabia."
    },
    {
      "cena": "EP14_C04",
      "bloco": 2,
      "inicioMs": 58000,
      "fimMs": 65000,
      "legenda": "Djanira: Você já jurou pela sua mãe uma vez. Foi quando você pegou os meus mil reais."
    },
    {
      "cena": "EP14_C04",
      "bloco": 3,
      "inicioMs": 65000,
      "fimMs": 74000,
      "legenda": "Dinjer: Ele me mandou te levar pro avião. Ele falou que era só pra conversar. Ele falou que ia te dar um emprego."
    },
    {
      "cena": "EP14_C04",
      "bloco": 4,
      "inicioMs": 74000,
      "fimMs": 76000,
      "legenda": "Djanira: E você acreditou."
    },
    {
      "cena": "EP14_C04",
      "bloco": 5,
      "inicioMs": 76000,
      "fimMs": 80000,
      "legenda": "Dinjer: Eu precisava acreditar, Djanira! Eu precisava!"
    },
    {
      "cena": "EP14_C05",
      "bloco": 1,
      "inicioMs": 80000,
      "fimMs": 90000,
      "legenda": "Dinjer: Djanira. Ele sabe que você tá viva. Ele descobriu na semana passada. E ele mandou te chamar pra jantar."
    },
    {
      "cena": "EP14_C05",
      "bloco": 2,
      "inicioMs": 90000,
      "fimMs": 93000,
      "legenda": "Djanira: Então diz pra ele que eu aceito."
    },
    {
      "cena": "EP14_C05",
      "bloco": 3,
      "inicioMs": 93000,
      "fimMs": 98000,
      "legenda": "Dinjer: Você não pode ir. Você não sabe quem ele é."
    },
    {
      "cena": "EP14_C05",
      "bloco": 4,
      "inicioMs": 98000,
      "fimMs": 103000,
      "legenda": "Djanira: Eu sei exatamente quem ele é. Eu descobri antes de você."
    },
    {
      "cena": "EP14_C05",
      "bloco": 5,
      "inicioMs": 103000,
      "fimMs": 110000,
      "legenda": "Narrador: Um jantar. Um pai. E uma verdade que vai virar tudo do avesso. Não perca o grande final de A Caloteira do Oeste."
    }
  ],

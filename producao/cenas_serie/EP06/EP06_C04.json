    },
    {
      "tipo": "fala",
      "duracaoSegundos": 9,
      "plano": "MEDIA",
      "texto": "Amiga! Que bom que você veio! Gente, olha! Essa aqui é a Djanira. A mulher mais honesta que eu conheço na vida inteira.",
      "personagem": "DINJER",
      "gesto": "explicando"
    },
    {
      "tipo": "fala",
      "duracaoSegundos": 6,
      "plano": "MEDIA",
      "texto": "Honestidade é raro hoje em dia, minha filha. Vale muito mais do que mil reais.",
      "personagem": "O_CHEFE",
      "gesto": "neutro"
    },
    {
      "tipo": "fala",
      "duracaoSegundos": 4,
      "plano": "MEDIA",
      "texto": "Como é que o senhor sabe dos mil reais?",
      "personagem": "DJANIRA_POBRE",
      "gesto": "neutro"
    },
    {
      "tipo": "fala",
      "duracaoSegundos": 6,
      "plano": "MEDIA",
      "texto": "Eu sei de tudo. É por isso que eu tô sentado nessa mesa e não naquela ali.",
      "personagem": "O_CHEFE",
      "gesto": "explicando"
    },
    {
      "tipo": "fala",
      "duracaoSegundos": 12,
      "plano": "MEDIA",
      "texto": "Vou te fazer uma proposta. Amanhã eu tenho um voo. Coisa rápida, um jantar lá em cima. Vem comigo. E lá eu te pago tudo que a Dinjer te deve. Em dinheiro vivo. Com juros.",
      "personagem": "O_CHEFE",
      "gesto": "explicando"
    },
    {
      "tipo": "fala",
      "duracaoSegundos": 4,
      "plano": "MEDIA",
      "texto": "E por que é que o senhor faria isso por mim?",
      "personagem": "DJANIRA_POBRE",
      "gesto": "neutro"
    },
    {
      "tipo": "fala",
      "duracaoSegundos": 5,
      "plano": "MEDIA",
      "texto": "Porque eu gosto de gente que trabalha. E porque eu quero te conhecer melhor.",
      "personagem": "O_CHEFE",
      "gesto": "neutro"
    }
  ],

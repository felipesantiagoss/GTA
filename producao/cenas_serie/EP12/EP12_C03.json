    {
      "tipo": "fala",
      "duracaoSegundos": 4,
      "plano": "DOIS",
      "texto": "Boa noite, senhora. Champanhe por conta da casa?",
      "personagem": "DINJER",
      "gesto": "neutro"
    },
    {
      "tipo": "fala",
      "duracaoSegundos": 3,
      "plano": "MEDIA",
      "texto": "Você trabalha aqui há muito tempo?",
      "personagem": "DJANIRA_RICA",
      "gesto": "neutro"
    },
    {
      "tipo": "fala",
      "duracaoSegundos": 9,
      "plano": "MEDIA",
      "texto": "Cinco anos. Mas é temporário, viu? Eu tô subindo na vida. Eu já fui aeromoça, de avião particular.",
      "personagem": "DINJER",
      "gesto": "explicando"
    },
    {
      "tipo": "fala",
      "duracaoSegundos": 2,
      "plano": "MEDIA",
      "texto": "E por que parou?",
      "personagem": "DJANIRA_RICA",
      "gesto": "neutro"
    },
    {
      "tipo": "fala",
      "duracaoSegundos": 4,
      "plano": "MEDIA",
      "texto": "Ah... é complicado. Coisa de patrão.",
      "personagem": "DINJER",
      "gesto": "negando"
    },
    {
      "tipo": "fala",
      "duracaoSegundos": 5,
      "plano": "MEDIA",
      "texto": "Me diz uma coisa. Você já fez alguma coisa de que se arrepende?",
      "personagem": "DJANIRA_RICA",
      "gesto": "neutro"
    },
    {
      "tipo": "fala",
      "duracaoSegundos": 3,
      "plano": "MEDIA",
      "texto": "Ai, senhora, eu faço isso todo dia.",
      "personagem": "DINJER",
      "gesto": "explicando"
    },
    {
      "tipo": "fala",
      "duracaoSegundos": 3,
      "plano": "MEDIA",
      "texto": "E teve alguma que doeu?",
      "personagem": "DJANIRA_RICA",
      "gesto": "neutro"
    },
    {
      "tipo": "fala",
      "duracaoSegundos": 2,
      "plano": "MEDIA",
      "texto": "...Uma.",
      "personagem": "DINJER",
      "gesto": "neutro"
    },
    {
      "tipo": "fala",
      "duracaoSegundos": 1,
      "plano": "MEDIA",
      "texto": "Conta.",
      "personagem": "DJANIRA_RICA",
      "gesto": "neutro"
    },
    {
      "tipo": "fala",
      "duracaoSegundos": 5,
      "plano": "MEDIA",
      "texto": "Eu não posso, senhora. Se eu contar, eu morro.",
      "personagem": "DINJER",
      "gesto": "implorando"
    }
